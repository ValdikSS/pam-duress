override_dh_auto_build:
	make CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)"

override_dh_auto_install:
	install -D -m755 bin/pam_test debian/libpam-duress-bin/usr/bin/pam_test
	install -D -m755 bin/duress_sign debian/libpam-duress-bin/usr/bin/duress_sign
	install -D -m644 bin/pam_duress.so debian/libpam-duress/usr/lib/$(DEB_HOST_MULTIARCH)/security/pam_duress.so

